# Local (docker compose): both point at the same database.
DATABASE_URL="postgresql://case:case@localhost:5432/case_studio?schema=public"
DIRECT_URL="postgresql://case:case@localhost:5432/case_studio?schema=public"

# Supabase + Vercel (serverless): app traffic goes through the TRANSACTION pooler (port 6543),
# migrations and seeding use the SESSION pooler (port 5432). Do not point the app at 5432: serverless
# functions exhaust its small connection pool and pages start failing intermittently.
# Paste only the URL into Vercel (no quotes, no "DATABASE_URL=" prefix).
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

AUTH_SECRET="replace-with-a-long-random-string"
